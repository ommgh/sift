[Unit]
Description=Sift indexer
Documentation=https://github.com/ommgh/sift
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# The index, thumbnails and face crops hold what's in your files: readable by you alone.
UMask=0077
NoNewPrivileges=yes
# Stop signals go to sift alone, which stops its llama-server once (a second SIGTERM makes it abort and dump core).
KillMode=mixed
ExecStart=%h/.local/bin/sift index
Restart=always
RestartSec=30
# Never in the way: the lowest CPU and disk priority, so it only uses what the rest of the desktop leaves free.
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle

[Install]
WantedBy=graphical-session.target
