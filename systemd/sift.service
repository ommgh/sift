[Unit]
Description=Sift search daemon
Documentation=https://github.com/ommgh/sift
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# The index, thumbnails and face crops hold what's in your files: readable by you alone.
UMask=0077
ExecStart=%h/.local/bin/sift serve
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
